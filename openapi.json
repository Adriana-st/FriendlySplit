{
  "openapi": "3.0.0",
  "info": {
    "title": "FriendlySplit API",
    "version": "1.0.0",
    "description": "REST API for FriendlySplit, a web application that helps groups of friends share the cost of a trip. A trip has many participants and many expenses. Each expense is paid by one participant and divided between several participants. The API can also calculate balances (who owes whom). All money amounts are whole numbers of cents (4550 = 45.50). Dates are written YYYY-MM-DD. 400 = failed validation, 404 = not found, 409 = conflicts with existing data, 422 = well formed but breaks a business rule. PUT replaces the whole resource."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Trips"
    },
    {
      "name": "Participants"
    },
    {
      "name": "Expenses"
    },
    {
      "name": "Balances"
    }
  ],
  "components": {
    "parameters": {
      "TripId": {
        "in": "path",
        "name": "tripId",
        "required": true,
        "description": "Id of the trip",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        }
      },
      "ParticipantId": {
        "in": "path",
        "name": "participantId",
        "required": true,
        "description": "Id of the participant",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        }
      },
      "ExpenseId": {
        "in": "path",
        "name": "expenseId",
        "required": true,
        "description": "Id of the expense",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        }
      },
      "Page": {
        "in": "query",
        "name": "page",
        "description": "Page number, starting at 1",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "in": "query",
        "name": "limit",
        "description": "Items per page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "The request failed validation (bad body, query string or id)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorBody"
            }
          }
        }
      },
      "NotFound": {
        "description": "The trip, participant or expense does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with existing data (duplicate email, or participant still in use)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Well formed request that breaks a business rule (for example a date outside the trip)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$",
        "example": "64f000000000000000000001"
      },
      "ListMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 3
          },
          "totalPages": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Trip not found"
          },
          "errors": {
            "description": "Extra information when available"
          }
        }
      },
      "ValidationErrorBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "example": "endDate"
                },
                "message": {
                  "type": "string",
                  "example": "endDate must not be before startDate"
                }
              }
            }
          }
        }
      },
      "Balances": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "totalSpent": {
            "type": "integer",
            "description": "Total of all expenses in cents",
            "example": 12000
          },
          "balances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "participant": {
                  "$ref": "#/components/schemas/ObjectId"
                },
                "name": {
                  "type": "string",
                  "example": "Adri"
                },
                "paid": {
                  "type": "integer",
                  "example": 9000
                },
                "owed": {
                  "type": "integer",
                  "example": 4000
                },
                "net": {
                  "type": "integer",
                  "description": "paid minus owed",
                  "example": 5000
                }
              }
            }
          },
          "settlements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/components/schemas/ObjectId"
                },
                "fromName": {
                  "type": "string",
                  "example": "Tom"
                },
                "to": {
                  "$ref": "#/components/schemas/ObjectId"
                },
                "toName": {
                  "type": "string",
                  "example": "Adri"
                },
                "amount": {
                  "type": "integer",
                  "example": 4000
                }
              }
            }
          }
        }
      },
      "TripInput": {
        "type": "object",
        "required": [
          "name",
          "currency",
          "startDate",
          "endDate"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60,
            "example": "Lisbon City Break"
          },
          "destination": {
            "type": "string",
            "maxLength": 80,
            "example": "Lisbon"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Three letter currency code (stored in upper case)",
            "example": "EUR"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Must not be before startDate",
            "example": "2026-07-08"
          }
        }
      },
      "Trip": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/ObjectId"
              }
            }
          },
          {
            "$ref": "#/components/schemas/TripInput"
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "ParticipantInput": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "example": "Adri"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "Must be unique within the trip (stored in lower case)",
            "example": "adri@example.com"
          }
        }
      },
      "Participant": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/ObjectId"
              },
              "trip": {
                "$ref": "#/components/schemas/ObjectId"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ParticipantInput"
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "Category": {
        "type": "string",
        "enum": [
          "food",
          "transport",
          "accommodation",
          "activities",
          "other"
        ]
      },
      "Split": {
        "type": "object",
        "required": [
          "participant",
          "share"
        ],
        "additionalProperties": false,
        "properties": {
          "participant": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "share": {
            "type": "integer",
            "minimum": 0,
            "description": "This person's share in cents",
            "example": 2000
          }
        }
      },
      "ExpenseInput": {
        "type": "object",
        "required": [
          "paidBy",
          "description",
          "amount",
          "category",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "paidBy": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "description": {
            "type": "string",
            "maxLength": 120,
            "example": "Seafood dinner"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Total in cents",
            "example": 6000
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Must fall within the trip dates",
            "example": "2026-07-03"
          },
          "splits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "description": "Optional. Each participant may appear once and the shares must add up exactly to amount. When left out, the amount is split equally between all participants of the trip.",
            "items": {
              "$ref": "#/components/schemas/Split"
            }
          }
        }
      },
      "Expense": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/ObjectId"
              },
              "trip": {
                "$ref": "#/components/schemas/ObjectId"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ExpenseInput"
          },
          {
            "type": "object",
            "required": [
              "splits"
            ],
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      }
    }
  },
  "paths": {
    "/trips": {
      "get": {
        "summary": "List trips (filter, sort, project and page)",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "destination",
            "description": "Partial, case-insensitive match on the destination",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "example": "lis"
          },
          {
            "in": "query",
            "name": "currency",
            "description": "Three letter currency code",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "example": "EUR"
          },
          {
            "in": "query",
            "name": "startsAfter",
            "description": "Only trips starting on or after this date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "startsBefore",
            "description": "Only trips starting on or before this date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "Field to sort by. Prefix with a minus sign for descending.",
            "schema": {
              "type": "string",
              "enum": [
                "startDate",
                "-startDate",
                "name",
                "-name",
                "createdAt",
                "-createdAt"
              ],
              "default": "-startDate"
            }
          },
          {
            "in": "query",
            "name": "fields",
            "description": "Comma separated list of fields to return (projection). _id is always returned.",
            "schema": {
              "type": "string"
            },
            "example": "name,currency"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of trips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trip"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a trip",
        "tags": [
          "Trips"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trip created",
            "headers": {
              "Location": {
                "description": "URL of the new trip",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trips/{tripId}": {
      "get": {
        "summary": "Get one trip",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          }
        ],
        "responses": {
          "200": {
            "description": "The trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Replace a trip",
        "description": "Fails with 422 if the new dates would leave any existing expense outside the trip.",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete a trip",
        "description": "Also deletes all of the trip's participants and expenses.",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          }
        ],
        "responses": {
          "204": {
            "description": "Trip deleted (no content)"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trips/{tripId}/participants": {
      "get": {
        "summary": "List the participants of a trip",
        "tags": [
          "Participants"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          },
          {
            "in": "query",
            "name": "name",
            "description": "Partial, case-insensitive match on the name",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "-name",
                "createdAt",
                "-createdAt"
              ],
              "default": "name"
            }
          },
          {
            "in": "query",
            "name": "fields",
            "description": "Comma separated list of fields to return (projection)",
            "schema": {
              "type": "string"
            },
            "example": "name,email"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of participants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Participant"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Add a participant to a trip",
        "tags": [
          "Participants"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParticipantInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant added",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trips/{tripId}/participants/{participantId}": {
      "get": {
        "summary": "Get one participant",
        "tags": [
          "Participants"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          },
          {
            "$ref": "#/components/parameters/ParticipantId"
          }
        ],
        "responses": {
          "200": {
            "description": "The participant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Replace a participant",
        "tags": [
          "Participants"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          },
          {
            "$ref": "#/components/parameters/ParticipantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParticipantInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated participant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Remove a participant",
        "description": "Fails with 409 if the participant paid for, or shares in, any expense.",
        "tags": [
          "Participants"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          },
          {
            "$ref": "#/components/parameters/ParticipantId"
          }
        ],
        "responses": {
          "204": {
            "description": "Participant removed (no content)"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trips/{tripId}/expenses": {
      "get": {
        "summary": "List the expenses of a trip (filter, sort, project and page)",
        "tags": [
          "Expenses"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "$ref": "#/components/schemas/Category"
            }
          },
          {
            "in": "query",
            "name": "paidBy",
            "description": "Only expenses paid by this participant",
            "schema": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          {
            "in": "query",
            "name": "search",
            "description": "Partial, case-insensitive match on the description",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "in": "query",
            "name": "minAmount",
            "description": "Minimum amount in cents",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "maxAmount",
            "description": "Maximum amount in cents",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "from",
            "description": "Only expenses on or after this date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "to",
            "description": "Only expenses on or before this date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "Field to sort by. Prefix with a minus sign for descending.",
            "schema": {
              "type": "string",
              "enum": [
                "date",
                "-date",
                "amount",
                "-amount"
              ],
              "default": "-date"
            }
          },
          {
            "in": "query",
            "name": "fields",
            "description": "Comma separated list of fields to return (projection)",
            "schema": {
              "type": "string"
            },
            "example": "description,amount"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of expenses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Expense"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Add an expense to a trip",
        "description": "If splits is left out, the amount is divided equally between every participant of the trip (any leftover cents go one each to the first participants). Business rules (422) - the payer and everyone in splits must be participants of this trip, and the date must fall within the trip dates.\n",
        "tags": [
          "Expenses"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TripId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Expense created",
