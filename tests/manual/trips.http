@baseUrl = http://localhost:3000/api/v1

### List trips
GET {{baseUrl}}/trips HTTP/1.1

### Create a trip
# @name postATrip
POST {{baseUrl}}/trips HTTP/1.1
Content-Type: application/json

{
  "name": "Paris City Break",
  "destination": "Paris",
  "currency": "EUR",
  "startDate": "2026-09-06",
  "endDate": "2026-09-12"
}

###
@tripId = {{postATrip.response.body._id}}

### Get one trip
GET {{baseUrl}}/trips/{{tripId}} HTTP/1.1

### Replace/update a trip
PUT {{baseUrl}}/trips/{{tripId}} HTTP/1.1
Content-Type: application/json

{
  "name": "Paris and Disneyland",
  "destination": "Paris",
  "currency": "EUR",
  "startDate": "2026-09-06",
  "endDate": "2026-09-12"
}

### Delete a trip
DELETE {{baseUrl}}/trips/{{tripId}} HTTP/1.1
Content-Type: application/json