@baseUrl = http://localhost:3000/api/v1
# a valid id that does not exist in the database
@missing = 64b7f0f0f0f0f0f0f0f0f0f0

### Create a trip with valid data -> 201 Created
# @name newTrip
POST {{baseUrl}}/trips HTTP/1.1
Content-Type: application/json

{
  "name": "Italy Adventure",
  "destination": "Rome, Florence, Venice",
  "currency": "eur",
  "startDate": "2026-08-12",
  "endDate": "2026-08-24"
}

###
# id of the trip created above (send the request above first)
@tripId = {{newTrip.response.body._id}}

### Create a trip with invalid data (bad currency, end date before start date) -> 400
POST {{baseUrl}}/trips HTTP/1.1
Content-Type: application/json

{
  "name": "Barcelona Weekend",
  "currency": "EUROS",
  "startDate": "2026-11-09",
  "endDate": "2026-11-06"
}

### List all trips -> 200
GET {{baseUrl}}/trips HTTP/1.1

### Get the trip created above -> 200
GET {{baseUrl}}/trips/{{tripId}} HTTP/1.1

### Get a trip that does not exist (valid id, no such trip) -> 404
GET {{baseUrl}}/trips/{{missing}} HTTP/1.1

### Get a trip with a badly formed id -> 400
GET {{baseUrl}}/trips/not-an-id HTTP/1.1

### Replace the trip with valid data -> 200
PUT {{baseUrl}}/trips/{{tripId}} HTTP/1.1
Content-Type: application/json

{
  "name": "Barcelona Long Weekend",
  "destination": "Barcelona",
  "currency": "EUR",
  "startDate": "2026-11-06",
  "endDate": "2026-11-10"
}

### Replace a trip that does not exist -> 404
PUT {{baseUrl}}/trips/{{missing}} HTTP/1.1
Content-Type: application/json

{
  "name": "Ghost Trip",
  "currency": "EUR",
  "startDate": "2026-11-06",
  "endDate": "2026-11-10"
}

### Replace the trip with invalid data (name too short) -> 400
PUT {{baseUrl}}/trips/{{tripId}} HTTP/1.1
Content-Type: application/json

{
  "name": "x",
  "currency": "EUR",
  "startDate": "2026-11-06",
  "endDate": "2026-11-10"
}

### Delete the trip -> 204 No Content
DELETE {{baseUrl}}/trips/{{tripId}} HTTP/1.1

### Delete the same trip again (already gone) -> 404
DELETE {{baseUrl}}/trips/{{tripId}} HTTP/1.1

### FILTERING, SORTING, PROJECTION AND PAGING

### Filter by destination (partial, case-insensitive) -> 200
GET {{baseUrl}}/trips?destination=lis HTTP/1.1

### Filter by currency -> 200
GET {{baseUrl}}/trips?currency=GBP HTTP/1.1

### Filter by start date range -> 200
GET {{baseUrl}}/trips?startsAfter=2026-08-01&startsBefore=2026-10-10 HTTP/1.1

### Sort by name, A to Z -> 200
GET {{baseUrl}}/trips?sort=name HTTP/1.1

### Sort by name, Z to A -> 200
GET {{baseUrl}}/trips?sort=-name HTTP/1.1

### Projection: only the name and currency fields -> 200
GET {{baseUrl}}/trips?fields=name,currency HTTP/1.1

### Paging: 2 trips per page, second page -> 200
GET {{baseUrl}}/trips?sort=name&limit=2&page=2 HTTP/1.1

### Unknown sort field -> 400
GET {{baseUrl}}/trips?sort=colour HTTP/1.1

### MongoDB operator injection attempt -> 400
GET {{baseUrl}}/trips?destination[$ne]=x HTTP/1.1